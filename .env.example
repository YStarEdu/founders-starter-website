# Week 4: copy this file, name the copy .env (same folder), and paste your own values.
# Find them in Supabase: Project Settings → Data API (Project URL) and Project Settings → API Keys.
# Use the PUBLISHABLE key (starts with sb_publishable_) or the legacy "anon" key.
# Never a secret key (sb_secret_...) or the service_role key: those skip every security rule.
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_paste-your-key-here
